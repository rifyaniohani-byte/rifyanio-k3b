        "updatedAt": { "type": "string" }
      },
      "required": ["id", "voyageNumber", "vesselId", "routeId", "status"]
    },
    "billsOfLading": {
      "title": "BillOfLading",
      "description": "Sea waybills and bills of lading",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "blNumber": { "type": "string" },
        "bookingDate": { "type": "string" },
        "voyageId": { "type": "string" },
        "customerId": { "type": "string" },
        "cargoCategory": { "type": "string" },
        "cargoDescription": { "type": "string" },
        "containerNumbers": { "type": "array" },
        "containerCount": { "type": "number" },
        "grossWeightTons": { "type": "number" },
        "volumeCbm": { "type": "number" },
        "freightRate": { "type": "number" },
        "handlingFee": { "type": "number" },
        "insuranceFee": { "type": "number" },
        "taxAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "cargoStatus": { "type": "string" },
        "consigneeName": { "type": "string" },
        "consigneeAddress": { "type": "string" },
        "consigneePhone": { "type": "string" },
        "shipperNotes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "blNumber", "voyageId", "customerId", "totalAmount"]
    },
    "trackingLogs": {
      "title": "CargoTrackingLog",
      "description": "Cargo tracking audit logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "blId": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" },
        "location": { "type": "string" },
        "notes": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "blId", "status", "timestamp"]
    }
