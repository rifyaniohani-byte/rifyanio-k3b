    "customers": {
      "title": "Customer",
      "description": "Shippers and cargo clients",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "picName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "npwp": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "code", "name", "category"]
    },
    "voyages": {
      "title": "Voyage",
      "description": "Voyage schedules and logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
