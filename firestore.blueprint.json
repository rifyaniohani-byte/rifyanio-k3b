{
  "entities": {
    "users": {
      "title": "User",
      "description": "App users and maritime staff credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "MANAGER", "OPERATOR"] },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "username", "name", "email", "role"]
    },
    "vessels": {
      "title": "Vessel",
      "description": "Maritime fleet vessels",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "callSign": { "type": "string" },
        "imoNumber": { "type": "string" },
        "capacityDWT": { "type": "number" },
        "capacityTEU": { "type": "number" },
        "yearBuilt": { "type": "number" },
        "flag": { "type": "string" },
        "currentPortId": { "type": "string" },
        "status": { "type": "string" },
        "speedKnots": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "name", "type", "status"]
    },
    "ports": {
      "title": "Port",
      "description": "Ports and maritime terminals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "city": { "type": "string" },
        "province": { "type": "string" },
        "coordinates": { "type": "object" },
        "wharfLengthMeters": { "type": "number" },
        "maxDraftMeters": { "type": "number" },
        "operationalHours": { "type": "string" },
        "contactPhone": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "code", "name", "city"]
    },
    "routes": {
      "title": "Route",
      "description": "Shipping routes and lanes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "originPortId": { "type": "string" },
        "destinationPortId": { "type": "string" },
